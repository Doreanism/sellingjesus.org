# Copy to .env.local and fill in. Only used by the emulator and never deployed, which is why
# the Lulu sandbox credentials and dev webhook belong here rather than in .env

# Lulu sandbox credentials, used automatically whenever running in the emulator
LULU_AUTH_SANDBOX=

# Discord webhook that all notifications go to during development
DISCORD_WEBHOOK_DEV=

# The emulator doesn't read Secret Manager, so secrets need dummy values here to run locally
CONFIRM_SECRET=local-test-secret
# Cloudflare's always-passes test secret, paired with the test sitekey in src/_comp/api.ts
TURNSTILE_SECRET=1x0000000000000000000000000000000AA
LULU_AUTH_PROD=unused-in-emulator
RESEND_API_KEY=unused-in-emulator
DISCORD_WEBHOOK_US=unused-in-emulator
DISCORD_WEBHOOK_AU=unused-in-emulator
DISCORD_WEBHOOK_PH=unused-in-emulator
DISCORD_WEBHOOK_OTHER=unused-in-emulator
