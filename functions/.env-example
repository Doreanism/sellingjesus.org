# Copy to .env and fill in. These are deployed with the function, so nothing sensitive
# (secrets live in Secret Manager, and dev-only values belong in .env.local instead)

# Contact email Lulu prints on each order (and uses to reach us about print jobs)
LULU_CONTACT_EMAIL=...
# Verified Resend sender address that admin order notifications come from
NOTIFY_EMAIL_FROM=...

# OAuth web client id for the dashboard's Google sign-in (public, not a secret)
# Create one under Google Cloud Console > APIs & Services > Credentials (Web application),
# with authorised origins https://sellingjesus.org and http://localhost:5173
GOOGLE_CLIENT_ID=...

# The one admin that can always sign in and can never be removed from the dashboard
# (every other admin is managed from the dashboard itself). Kept here so it stays out of git.
SUPER_ADMIN=...
