# Copy to .env and fill in. These are deployed with the function, so nothing sensitive
# (secrets live in Secret Manager, and dev-only values belong in .env.local instead)

# Where US order notifications are emailed, and the verified Resend sender they come from
ORDERS_EMAIL_TO=...
ORDERS_EMAIL_FROM=...

# Leave empty: the function works out its own URL for confirm links
# Only set this if those links ever come out pointing at the wrong place
API_BASE_URL=
